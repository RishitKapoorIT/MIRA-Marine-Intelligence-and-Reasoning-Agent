# ─── App ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ─── Database (PostgreSQL + PostGIS, Docker) ─────────────────────────
# SQLAlchemy/asyncpg dialect form — used by app/db/session.py
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/orca

# ─── Session / auth  (FR-H2.2) ───────────────────────────────────────
SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32
SESSION_LIFETIME_DAYS=30

# ─── Firebase Phone Auth  (EI-12, FR-H1.2) ───────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# ─── LLM  (orchestrator + specialists) ───────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Language layer  (FR-A6.2 — provider swappable by config) ────────
LANGUAGE_PROVIDER=sarvam
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v1

# ─── PFZ microservice  (services/pfz-api) ────────────────────────────
PFZ_API_BASE_URL=http://localhost:8001
PFZ_API_TIMEOUT_SECONDS=30
PFZ_API_BATCH_SIZE=500

# ─── NASA Ocean Color / OB.DAAC  (EI-1, FR-C1.1) ─────────────────────
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ─── Keyless sources — endpoints held as config, not hardcoded ───────
# Open-Meteo (EI-3, EI-4) · CC BY 4.0 attribution required
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# NDMA SACHET CAP feed (EI-5)
SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
SACHET_POLL_INTERVAL_MINUTES=15